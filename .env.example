# Arkham MCP — Environment variables
# Copy to .env and fill in your credentials

# --- Auth: at least one is required ---

# Option 1: API key (official)
ARKHAM_API_KEY=your_api_key_here

# Option 2: Browser session cookie
# ARKHAM_COOKIE=AMP_f072531383=JTdC...

# You can provide both
# ARKHAM_API_KEY=your_key
# ARKHAM_COOKIE=AMP_f072531383=JTdC...

# --- Other settings ---
ARKHAM_BASE_URL=https://api.arkm.com
ARKHAM_PROVIDER=arkham   # available: arkham, playwright
